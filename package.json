    "packageManager": "bun@1.3.6",
    "devDependencies": {
        "@types/bun": "latest",
        "oxfmt": "^0.31.0",
        "oxlint": "^1.49.0",
        "oxlint-tsgolint": "^0.13.0"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "turbo": "^2.8.10"
    }
}