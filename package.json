{
    "name": "rms",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev": "turbo dev",
        "build": "turbo build",
        "test": "turbo test",
        "typecheck": "turbo typecheck",
        "lint": "turbo lint",
        "format": "turbo format",
        "clean": "rm -rf .turbo node_modules apps/*/node_modules apps/*/dist apps/client/.nuxt apps/client/.output && bun install"
